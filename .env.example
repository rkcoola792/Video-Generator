# Gemini API credentials are read by the local server and never sent to the browser.
DATABASE_URL=postgresql://little_lessons:change-this-password@localhost:5432/little_lessons
DATABASE_SSL=false
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional backup for lesson text when Gemini is unavailable.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
BRAVE_SEARCH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional curated voice choices. Add IDs that are available in your ElevenLabs account.
ELEVENLABS_VOICE_ID_1=
ELEVENLABS_VOICE_NAME_1=Warm storyteller
ELEVENLABS_VOICE_ID_2=
ELEVENLABS_VOICE_NAME_2=Bright guide
ELEVENLABS_VOICE_ID_3=
ELEVENLABS_VOICE_NAME_3=Calm narrator
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Meta Instagram Login. Register this exact callback URL in your Meta app settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4174/api/v1/social/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v26.0
APP_BASE_URL=http://localhost:5173
# Generate a random 32-byte key (64 hex characters) for encrypting saved Instagram tokens.
TOKEN_ENCRYPTION_KEY=
# Optional Cloudflare R2 storage. Leave all four blank to use local .data storage.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PORT=4174
