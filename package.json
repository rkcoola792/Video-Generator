{
  "name": "lesson-video-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:vite\"",
    "api": "tsx watch server/index.ts",
    "vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "render": "remotion render src/remotion/index.ts LessonVideo out/sky-blue-prototype.mp4"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "remotion": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
